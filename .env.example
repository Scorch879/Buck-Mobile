# ==============================================================================
# BUCK MOBILE - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure your variables:
#   cp .env.example .env
# ==============================================================================

# --- SUPABASE & WEB CONFIGURATION ---
NEXT_PUBLIC_SITE_URL=https://bucktbt-dev.vercel.app/
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co/
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- BUCK AI SERVICE CONFIGURATION ---
BUCK_AI_URL=https://buck-web-ai.vercel.app/

# --- DEV MODE & ADMIN AUTHENTICATION ---
DEV_MODE=true
DEV_ADMIN_EMAIL=admin@buck.dev
DEV_ADMIN_PASSWORD=AdminPassword123!
DEV_ADMIN_NAME=Admin User
DEV_AUTO_FILL_ADMIN=true

# --- ENVIRONMENT METADATA ---
APP_ENV=development
APP_NAME=Buck Mobile
APP_DEBUG=true
